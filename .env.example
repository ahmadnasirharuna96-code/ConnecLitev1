# =============================================================
# ConnectLite — Environment Variables
# Copy this file to backend/.env and fill in real values.
# NEVER commit the real .env file.
# =============================================================

# --- Django core ---
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ENVIRONMENT=development

# --- Database (PostgreSQL) ---
DATABASE_URL=postgres://connectlite:connectlite@localhost:5432/connectlite
# Individual fallbacks if DATABASE_URL isn't used:
DB_NAME=connectlite
DB_USER=connectlite
DB_PASSWORD=connectlite
DB_HOST=localhost
DB_PORT=5432

# --- JWT ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Africa's Talking ---
AT_USERNAME=sandbox
AT_API_KEY=your-sandbox-api-key
AT_ENVIRONMENT=sandbox
AT_SENDER_ID=
AT_DEMO_MODE=true
# When AT_DEMO_MODE=true, SMS/Airtime/Voice calls are handled by local mock
# adapters that never contact Africa's Talking. Flip to false + supply real
# sandbox/production credentials to go live. No application code changes
# are required to make that switch.

# --- OTP ---
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
